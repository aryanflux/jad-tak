# PostgreSQL connection used by every API route (shared pool in lib/db.ts).
# Requires the pgvector extension (see db/schema.sql at the repo root).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jhar_samadhan

# FastAPI triage microservice (Module 2) — optional at runtime; intake and
# dedupe degrade gracefully when unreachable.
SBERT_SERVICE_URL=http://localhost:8000/api/v1/embed

# Optional tunables (see route headers for defaults)
# DEDUPE_WINDOW_DAYS=90

# Bhashini voice transcription (keep these server-side; do not use NEXT_PUBLIC_).
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
# BHASHINI_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Mappls reverse geocoding. MAPPLS_API_KEY is preferred for server-side use.
MAPPLS_API_KEY=your_mappls_api_key_here

# Supabase browser Auth configuration (safe public values).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
